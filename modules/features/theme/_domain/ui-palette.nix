#
# What each colour means in a desktop interface, as base16 slots. Anything
# drawing an interface names these roles, so a scheme or polarity change
# reaches it without per-component colour choices.
#
_: {
  background = "base00";
  surface = "base01";
  surfaceRaised = "base02";
  outline = "base03";
  muted = "base04";
  text = "base05";
  accent = "base0D";
  accentText = "base00";
  danger = "base08";
  warning = "base09";
  success = "base0B";
}
