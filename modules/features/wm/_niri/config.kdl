input {
    touchpad {
        tap
        dwt
    }
}

layout {
    gaps 12
    default-column-width { proportion 0.5; }
    focus-ring { width 2; }

    // 👑 THE INSET FIX: Reserves a 32px safety clearance zone at the top of the monitor
    // This perfectly prevents application panels from overlapping your active Waybar!
    struts {
        top 32
    }
}

binds {
    "Mod+Return" { spawn "alacritty"; }
    "Mod+Q" { close-window; }
    
    "Mod+Left"  { focus-column-left; }
    "Mod+Right" { focus-column-right; }
    
    "Mod+Shift+E" { quit; }
}
